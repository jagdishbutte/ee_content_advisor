# Copy to .env.local and fill in. Never commit real values.
# (Rename this file to .env.example if you prefer the conventional name.)

# Supabase (Project Settings → API). Service role key is server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LLM — any OpenAI-compatible endpoint (default: Groq free tier)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Optional: used when the main model keeps failing
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Cost / rate-limit controls
LLM_CALL_DELAY_MS=3000
MAX_BRIEFS_PER_RUN=6
LLM_DAILY_CALL_BUDGET=100
LLM_DAILY_TOKEN_BUDGET=150000
# Stop starting new LLM calls after this many ms of a run (Vercel kills functions at 300s)
RUN_TIME_BUDGET_MS=270000

# Telegram digest (optional — skipped when unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard + cron protection
DASHBOARD_PASSWORD=
# At least 16 random characters, e.g. `openssl rand -hex 32`
CRON_SECRET=

# Public URL of the deployed dashboard (used for links in Telegram)
APP_BASE_URL=http://localhost:3000
